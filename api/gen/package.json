{
  "name": "@plateau/api",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*.errors": {
      "types": "./ts/*.errors.ts",
      "import": "./ts/*.errors.ts"
    },
    "./*.crud": {
      "types": "./ts/*.crud.ts",
      "import": "./ts/*.crud.ts"
    },
    "./*": {
      "types": "./ts/*/index.ts",
      "import": "./ts/*/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@servora/proto-utils": "^0.1.10"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
