# IAM 公开入口
IAM_PUBLIC_ORIGIN=http://localhost:10002

# PostgreSQL 初始化与服务连接；数据库、角色或密码变更时同步连接串
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_SERVICE_DATABASES=openfga,iam,admin
OPENFGA_DATABASE_NAME=openfga
IAM_DATABASE_NAME=iam
IAM_DATABASE_ROLE=iam
IAM_DATABASE_PASSWORD=iam
IAM_DATABASE_SOURCE=postgres://iam:iam@localhost:5432/iam?sslmode=disable
ADMIN_DATABASE_NAME=admin
ADMIN_DATABASE_SOURCE=postgres://postgres:postgres@localhost:5432/admin?sslmode=disable

# Redis 与 IAM 缓存连接；密码变更时同步连接配置
REDIS_PASSWORD=redis
IAM_REDIS_ADDR=localhost:6379
IAM_REDIS_PASSWORD=redis

# ClickHouse 与 Audit 连接
CLICKHOUSE_DB=audit
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# IAM 邮件服务
IAM_SMTP_HOST=localhost

# OpenFGA：模型脚本与服务共用
FGA_API_URL=http://localhost:18080
FGA_STORE_ID=
FGA_MODEL_ID=

# IAM 能力凭证签名密钥；部署时设置至少 32 字节的随机值
IAM_CAP_SIGNING_SECRET=change-me-to-a-random-value-at-least-32-bytes-long
