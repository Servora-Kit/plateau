{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": [
    "before 6am on monday"
  ],
  "automerge": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "mise": {
    "enabled": true
  },
  // Experimental (Renovate 44.236+): sync minimumReleaseAge and minimumReleaseAgeExclude
  // from each workspace's pnpm-workspace.yaml (root: 1440 min / 1 day excluding
  // @servora/proto-utils; app/admin/web: 0) so lockfile updates match pnpm v12 checks in CI.
  // Revisit once Renovate stabilizes or enables this behavior by default.
  "minimumReleaseAgePackageManagerSync": true,
  "packageRules": [
    {
      "description": "Keep the go directive as the minimum version; patch releases go through the toolchain directive",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Bump the go directive on minor releases",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group Go tool directive dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "tool"
      ],
      "groupName": "go-tools"
    },
    {
      "description": "Track protoc plugin modules that go.mod only requires indirectly for tool directives",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "google.golang.org/grpc/cmd/protoc-gen-go-grpc",
        "github.com/go-kratos/kratos/cmd/protoc-gen-go-http/**",
        "github.com/google/gnostic",
        "github.com/envoyproxy/protoc-gen-validate"
      ],
      "enabled": true,
      "groupName": "go-tools"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group mise tool version updates",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise"
    },
    {
      "description": "Group root pnpm workspace dependencies",
      "matchManagers": [
        "npm"
      ],
      "groupName": "root-web"
    },
    {
      "description": "Group Vben admin web workspace dependencies on a monthly schedule",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "app/admin/web/**"
      ],
      "groupName": "admin-web",
      "schedule": [
        "before 6am on the first day of the month"
      ]
    },
    {
      "description": "Group Docker Compose image updates without pinning latest digests",
      "matchManagers": [
        "docker-compose"
      ],
      "pinDigests": false,
      "groupName": "compose-images"
    },
    {
      "description": "Group Servora Go modules, protoc tools, and npm packages together",
      "matchPackageNames": [
        "github.com/Servora-Kit/**",
        "@servora/*"
      ],
      "groupName": "servora",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
