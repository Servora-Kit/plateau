# 本地配置与密钥
/.env
.env.local
.env.*.local
*.key
*.pem
*.crt
*.cert
/configs/keys/

# Go 工作区与服务产物
/go.work
/go.work.sum
/app/*/service/bin/
/app/*/service/tmp/
/app/*/service/logs/
/app/*/service/server
