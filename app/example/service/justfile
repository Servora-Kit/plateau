    @{{ if SERVORA_EXAMPLE_SQLITE_DSN == "" { error("SERVORA_EXAMPLE_SQLITE_DSN is required") } else { "$env:GOWORK = \"off\"; go test -tags=integration ./internal/service -run '^TestUserReferenceIntegration$' -count=1" } }}
