{
  "name": "@vben/plugins",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vxe-table": {
      "types": "./src/vxe-table/index.ts",
      "default": "./src/vxe-table/index.ts"
    },
    "./motion": {
      "types": "./src/motion/index.ts",
      "default": "./src/motion/index.ts"
    }
  },
  "dependencies": {
    "@vben-core/design": "workspace:*",
